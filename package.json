{
  "name": "dsh-mobbin-mcp",
  "version": "0.1.1",
  "description": "Mobbin MCP server for DeepSeek Harness — OAuth 2.0 (PKCE) login, Mobbin screen search and collection tools.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mobbin",
    "oauth",
    "design",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhitiaojun/dsh-mobbin-mcp.git"
  },
  "homepage": "https://github.com/zhitiaojun/dsh-mobbin-mcp#readme",
  "bugs": {
    "url": "https://github.com/zhitiaojun/dsh-mobbin-mcp/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/oauth.js && node --check lib/mobbin.js",
    "test": "node --test test/*.test.mjs",
    "login": "node scripts/login.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
